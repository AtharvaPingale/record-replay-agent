{
  "business_outcomes": [],
  "recoverable_patterns": [],
  "checkpoint": {
    "type": "selector_visible",
    "value": ".users-card :text(\"{{account_number}}\")"
  },
  "output_schema": {
    "account_balance": "string"
  },
  "output_extractors": [
    {
      "name": "account_balance",
      "target": {
        "kind": "dom_selector",
        "value": ".users-card :text-matches(\"^[$][0-9,]+([.][0-9]{2})?$\")"
      }
    }
  ]
}